ACURAST_MNEMONIC=

# Target network: canary or mainnet. Selects the tunnel relays and chain RPC at runtime.
# Keep this in sync with the `network` field in acurast.json.
NETWORK=canary

# DNS suffix you control (wildcard `*` + `_acu` TXT records published), one name
# per network. Set ONLY the one matching $NETWORK; that var must also be the one
# listed in acurast.json's includeEnvironmentVariables.
DOMAIN_SUFFIX_CANARY=
DOMAIN_SUFFIX_MAINNET=

CALLBACK_URL=

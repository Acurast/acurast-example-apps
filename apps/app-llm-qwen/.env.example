# Deployer wallet: `acurast init` creates one; fund it with a few ACU on mainnet.
ACURAST_MNEMONIC=

# Target network: canary or mainnet. Selects the tunnel relays at runtime.
# Keep this in sync with the `network` field in acurast.json.
NETWORK=mainnet

# 32-byte hex seed that fixes the tunnel URL of each phone (one URL per replica slot).
# Create one with: node tools/gen-tunnel-keys.mjs --new-seed 1  (it also prints the URL)
TUNNEL_SEED=

# Required. Clients must send `Authorization: Bearer <LLM_API_KEY>`; the tunnel URL is
# public, so the app refuses to serve the model without one. Any random string: openssl rand -hex 16
LLM_API_KEY=

# OPTIONAL overrides (defaults in src/index.js): MODEL_URL, CTX_SIZE, PARALLEL, KV_TYPE,
# VARIANTS, BENCH_THREADS. If you set one, also add its name to
# acurast.json -> includeEnvironmentVariables.
# MODEL_URL=https://huggingface.co/unsloth/Qwen3.5-9B-GGUF/resolve/main/Qwen3.5-9B-Q4_K_M.gguf

# Deployer wallet: `acurast init` creates one; fund it with a few ACU on mainnet. Do not commit.
ACURAST_MNEMONIC=

# Target network: canary or mainnet. Selects the tunnel relays at runtime.
# Keep this in sync with the `network` field in acurast.json.
NETWORK=mainnet

# Required. Clients must send `Authorization: Bearer <LLM_API_KEY>`; the tunnel URL is
# public, so the app refuses to start without one. Any random string: openssl rand -hex 16
LLM_API_KEY=

# OPTIONAL: fixed tunnel key -> fixed URL, known before deploying and the same on every
# start. Create one with tools/tunnel_key.sh (it prints the URL). Only one phone at a
# time may use a key. Empty = a new random URL on every start (sent to CALLBACK_URL).
TUNNEL_KEY=

# Model: 0.8B, 4B (default) or 9B. Set minRamTotalBytes in acurast.json to match (README).
LLM_MODEL=4B

# OPTIONAL: MNN threads. Empty = 8 on phones without efficiency cores, else 4.
LLM_THREADS=

# OPTIONAL: 1 = the model thinks before it answers unless a request says otherwise.
# Empty = direct answers (requests can still ask for thinking per call).
LLM_THINKING=

# OPTIONAL: webhook that receives JSON lifecycle events (log, started, ready, error).
CALLBACK_URL=

# OPTIONAL: root password for SSH over the secondary tunnel (debugging). Empty = no SSH.
SSH_PASSWORD=

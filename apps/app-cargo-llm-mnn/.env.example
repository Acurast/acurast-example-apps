# Deployer wallet: `acurast init` creates one; fund it with a few ACU on mainnet. Do not commit.
ACURAST_MNEMONIC=

# Target network: canary or mainnet. Selects the tunnel relays at runtime.
# Keep this in sync with the `network` field in acurast.json.
NETWORK=mainnet

# Required. Clients must send `Authorization: Bearer <LLM_API_KEY>`; the tunnel URL is
# public, so the app refuses to start without one. Any random string: openssl rand -hex 16
LLM_API_KEY=

# Required. Fixed tunnel key -> fixed URL, known before deploying and the same on every
# start. Create one with tools/tunnel_key.sh (it prints TUNNEL_KEY=... and the URL).
# Only one phone at a time may use a key.
TUNNEL_KEY=

# Model: 0.8B, 4B (default) or 9B. Set minRamTotalBytes in acurast.json to match (README).
LLM_MODEL=4B

# ---------------------------------------------------------------------------
# Optional. The CLI refuses to deploy while a name listed in acurast.json ->
# includeEnvironmentVariables has no value, so these are not listed there. To use
# one, set it here AND add its name to includeEnvironmentVariables, or it never
# reaches the phone.
# ---------------------------------------------------------------------------

# MNN threads. Unset = 8 on phones without efficiency cores, else 4 (pinned to the
# fast cores). Setting it also turns off the pinning.
# LLM_THREADS=

# 1 = the model thinks before it answers unless a request says otherwise.
# Unset = direct answers (requests can still ask for thinking per call).
# LLM_THINKING=1

# Webhook that receives JSON lifecycle events (log, started, ready, error).
# CALLBACK_URL=

# Root password for SSH over the secondary tunnel (debugging). Unset = no SSH.
# SSH_PASSWORD=

ACURAST_MNEMONIC=

SSH_PASSWORD=
CALLBACK_URL=

# Target network: canary or mainnet. Selects the tunnel relays at runtime.
# Keep this in sync with the `network` field in acurast.json.
NETWORK=mainnet

# Required. Clients must send `Authorization: Bearer <LAYA_API_KEY>`; the tunnel
# URL is public, so the deployment refuses to start without one.
LAYA_API_KEY=

# 1 = the demo pages served at / get the API key automatically, so anyone with
# the URL can use the demos (and the API). Empty/0 = visitors enter the key.
LAYA_DEMO_PUBLIC=1

# OPTIONAL: fixed tunnel key -> fixed URL, known before deploying and the same on every
# start. Create one with tools/tunnel_key.sh (it prints the URL). Only one phone at a
# time may use a key. Empty = a new random URL on every start (sent to CALLBACK_URL).
TUNNEL_KEY=

# OPTIONAL: custom domain (see app-cargo-postgres for details). If set, also add
# the var name to acurast.json -> includeEnvironmentVariables.
# DOMAIN_SUFFIX_MAINNET=
# DOMAIN_SUFFIX_CANARY=

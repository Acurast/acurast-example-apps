# Deployer seed phrase used by the Acurast CLI to sign the deployment. Do not commit.
ACURAST_MNEMONIC=

# Root password for the SSH session (defaults to "password" — set a strong value).
SSH_PASSWORD=

# Optional webhook that receives JSON lifecycle events (log, started, error).
CALLBACK_URL=

# Target network: canary or mainnet. Selects the tunnel relays at runtime.
# Keep this in sync with the `network` field in acurast.json.
NETWORK=mainnet

# DNS suffix you control (wildcard `*` + `_acu` TXT records published), one name
# per network. Set ONLY the one matching $NETWORK; that var must also be the one
# listed in acurast.json's includeEnvironmentVariables.
DOMAIN_SUFFIX_MAINNET=tunnel.acurast.dev
DOMAIN_SUFFIX_CANARY=

# OpenRouter API key for OpenClaw (https://openrouter.ai/keys). Exported into the
# session; OpenClaw is pinned to provider=openrouter at startup.
OPENROUTER_API_KEY=

# OpenRouter model id OpenClaw should use (optional; defaults to openai/gpt-4o-mini).
# The openrouter/ prefix is added automatically. e.g. openai/gpt-4o,
# anthropic/claude-sonnet-4, meta-llama/llama-3.3-70b-instruct
OPENCLAW_MODEL=openai/gpt-4o-mini

# Password protecting the OpenClaw Control UI (the PRIMARY tunnel URL is public —
# without this, anyone who reaches it can run commands as the agent). If unset,
# start.sh generates a strong one and reports it via the `webui_password`
# callback event, so the URL is never left open. Set it to choose your own.
OPENCLAW_GATEWAY_PASSWORD=
